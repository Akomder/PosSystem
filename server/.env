    PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=posuser
DB_PASSWORD=pospassword
DB_NAME=posdb

# JWT
JWT_SECRET=bellavista_pos_super_secret_jwt_key_change_in_prod
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=bellavista_pos_refresh_secret_key_also_change
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Tax rate
TAX_RATE=0.10

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank → auto Ethereal test account in development.
# For Gmail: host=smtp.gmail.com  port=587  user=you@gmail.com  pass=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=POS System
EMAIL_FROM_ADDRESS=noreply@pos.system

# Base URL for password-reset links (frontend)
APP_URL=http://localhost:5173
