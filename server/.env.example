# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=posdb
# Set DB_SSL=true when connecting to cloud-hosted PostgreSQL (RDS, Supabase, Neon, etc.)
DB_SSL=false

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate secure values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_48_RANDOM_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_48_RANDOM_HEX_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
# URL where your React frontend is hosted (no trailing slash)
CLIENT_ORIGIN=https://your-frontend-domain.com

# ─── Tax ───────────────────────────────────────────────────────────────────────
TAX_RATE=0.10

# ─── SMTP (optional — can also be configured via SuperAdmin UI) ─────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
EMAIL_FROM_NAME=POS System
EMAIL_FROM_ADDRESS=noreply@your-domain.com
